	(text "LUCHTMETER S3 v2.0 - ESP32-S3-WROOM-1U (external antenna) behind a Waveshare 4.3in 800x480 IPS capacitive touchscreen (generated from tools/design.py)"
		(exclude_from_sim no)
		(at 15 552 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "6ad25fe6-cb0c-5fe4-89d3-fbd514958445")
	)
	(text "Screen FFC J1 (40p 0.5 mm, RGB565): physical pin k = screen pin 41-k. R3-7 IO41 IO42 IO44 IO43 IO18, G2-7 IO45 IO46 IO3 IO38 IO39 IO40, B3-7 IO13 IO14 IO21 IO47 IO48, PCLK IO9 DE IO10 HSYNC IO11 VSYNC IO12, backlight PWM IO2."
		(exclude_from_sim no)
		(at 15 556 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "77619391-5ebd-5201-9139-04703776e621")
	)
	(text "Touch GT911 on I2C1 (SDA IO7, SCL IO8, INT IO6, address 0x5D). Sensors + NFC on I2C0 (SDA IO4, SCL IO5): SCD41 0x62, SHT45 0x44, LTR-303 0x29, ST25DV 0x53/0x57/0x2D."
		(exclude_from_sim no)
		(at 15 560 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "1021a1c6-c7c9-5cd1-8da0-056a6732dca0")
	)
	(text "Power: USB-C -> BQ24075 (charge 250 mA, power path) -> LiPo on BAT+/BAT- (DW01A) -> XC6220 3.3 V. Screen 5 V from TPS61023 (DISP_ON IO17 high). Sensors + NFC on 3V3_SW (PWR_EN IO15 low = on)."
		(exclude_from_sim no)
		(at 15 564 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "cf93f05f-b3b7-52dc-a002-3b627506933c")
	)
	(text "Wake from deep sleep: WEKKEN button (IO0) or NFC field (ST25DV GPO -> IO16). Battery voltage = ADC(IO1) x 2."
		(exclude_from_sim no)
		(at 15 568 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
